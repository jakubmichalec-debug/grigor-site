# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# source media: several of these files are over GitHub's 100 MB limit, and the
# site does not need them to run — it only serves what is in /public. The
# scripts that built /public from them are kept.
/Jalub Website videos & photos/*
!/Jalub Website videos & photos/_header-edit/
/Jalub Website videos & photos/_header-edit/*
!/Jalub Website videos & photos/_header-edit/README.md
!/Jalub Website videos & photos/_header-edit/pipeline/
/Jalub Website videos & photos/_header-edit/pipeline/*
!/Jalub Website videos & photos/_header-edit/pipeline/*.py
